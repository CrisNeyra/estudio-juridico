# -----------------------------------------------------------------------------
# Copiá este archivo como .env.local y completá solo lo que vayas a usar.
# TODAS las variables son opcionales: sin ellas el sitio funciona con fallbacks.
# Nunca subas .env.local a git (ya está en .gitignore).
# -----------------------------------------------------------------------------

# URL pública del sitio (canonical, sitemap, Open Graph). En Vercel: tu dominio.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Asistente IA (Google Gemini) -------------------------------------------
# https://aistudio.google.com/apikey — sin clave, el chat muestra un fallback a WhatsApp.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# 1 = respuestas simuladas sin llamar a la API (tests E2E / demos sin costo).
AI_MOCK=

# --- Email (recomendado: Gmail SMTP gratis, sin dominio) ---------------------
# Paso a paso: docs/runbooks/gmail-smtp.md
# Cuenta Gmail + verificación en 2 pasos + Contraseña de aplicaciones.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Destinatario del estudio (puede ser el mismo Gmail u otro).
CONTACT_TO_EMAIL=
# Remitente visible. Ej.: "Dra. Paula Sardo <paula.f.sardo@gmail.com>"
# Si lo dejás vacío, se usa "Estudio <GMAIL_USER>".
CONTACT_FROM_EMAIL=

# --- Email (opcional: Resend, requiere dominio verificado para mails reales) --
# https://resend.com — solo se usa si NO hay Gmail configurado.
RESEND_API_KEY=

# --- Rate limiting distribuido (Upstash Redis) ------------------------------
# Recomendado en producción. Sin esto se usa un limitador en memoria (1 instancia).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Anti-bots (Cloudflare Turnstile) ---------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Neon + Auth.js + Vercel Blob (turnos, portal, documentos) --------------
# Guía: docs/runbooks/neon-setup.md
# Neon: https://console.neon.tech → connection string
DATABASE_URL=
# Auth.js: openssl rand -base64 32
AUTH_SECRET=
# Vercel → Storage → Blob (token del store conectado al proyecto)
BLOB_READ_WRITE_TOKEN=
