# -----------------------------------------------------------------------------
# Copiá este archivo como .env.local y completá solo lo que vayas a usar.
# TODAS las variables son opcionales: sin ellas el sitio funciona con fallbacks.
# Nunca subas .env.local a git (ya está en .gitignore).
# -----------------------------------------------------------------------------

# URL pública del sitio (canonical, sitemap, Open Graph). En Vercel: tu dominio.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Asistente IA (Google Gemini) -------------------------------------------
# https://aistudio.google.com/apikey — sin clave, el chat muestra un fallback a WhatsApp.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# 1 = respuestas simuladas sin llamar a la API (tests E2E / demos sin costo).
AI_MOCK=

# --- Email (Resend) ----------------------------------------------------------
# https://resend.com — sin clave, en desarrollo los mensajes se loguean en consola.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Remitente de un dominio verificado en Resend, ej.: "Arce & Valdés <no-reply@tudominio.com.ar>"
CONTACT_FROM_EMAIL=

# --- Rate limiting distribuido (Upstash Redis) ------------------------------
# Recomendado en producción. Sin esto se usa un limitador en memoria (1 instancia).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Anti-bots (Cloudflare Turnstile) ---------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Supabase (turnos, portal de clientes) ----------------------------------
# Dashboard > Project Settings > API. La anon key es pública y está protegida por RLS.
# NO uses la service_role key en esta app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
